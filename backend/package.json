{
  "name": "eventtrack-backend",
  "version": "0.1.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:create": "node scripts/create-db.js",
    "db:migrate": "node scripts/migrate.js",
    "db:status": "node scripts/migrate.js --status",
    "db:seed": "node scripts/seed.js",
    "db:seed:demo": "node scripts/seed.js --demo",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "license": "UNLICENSED",
  "description": "API REST de EventTrack (Node.js + Express + PostgreSQL)",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
