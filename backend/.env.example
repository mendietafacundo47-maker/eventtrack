# Copia este archivo como .env y ajusta los valores. NUNCA subas .env al repositorio.

NODE_ENV=development
PORT=3000
# Orígenes permitidos para el panel web (separados por coma). Vacío = ninguno.
CORS_ORIGINS=http://localhost:8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave
DB_NAME=eventtrack
DB_SSL=false

# JWT: genera un secreto aleatorio de al menos 32 caracteres, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=reemplaza_con_un_secreto_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRES_IN=8h

# Costo de bcrypt (10-14). Más alto = más seguro y más lento.
BCRYPT_ROUNDS=12

# Usuario administrador inicial creado por `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@uajms.edu.bo
SEED_ADMIN_NAME=Administrador del sistema
SEED_ADMIN_PASSWORD=cambia_esta_clave_admin

# Contraseña de los usuarios de prueba creados por `npm run db:seed:demo`
# (solo desarrollo). Debe tener al menos 8 caracteres.
SEED_DEMO_PASSWORD=Demo1234

# Almacenamiento de fotografías de evidencia (fuera de rutas públicas).
UPLOAD_DIR=uploads
# Tamaño máximo de cada foto en MB (TC-18).
MAX_PHOTO_MB=8
